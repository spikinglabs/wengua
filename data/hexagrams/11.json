{
  "number": 11,
  "unicode": "䷊",
  "binary": "111000",
  "trigrams": {
    "lower": "qian",
    "upper": "kun"
  },
  "name": {
    "zh_hant": "泰",
    "zh_hans": "泰",
    "pinyin": "tài",
    "en": "Peace"
  },
  "judgment": {
    "zh_hant": "小往大來，吉，亨。",
    "zh_hans": "小往大来，吉，亨。"
  },
  "tuan": {
    "zh_hant": "泰、小往大來、吉、亨。則是天地交而萬物通也，上下交而其志同也。內陽而外陰，內健而外順，內君子而外小人，君子道長，小人道消也。",
    "zh_hans": "泰、小往大来、吉、亨。则是天地交而万物通也，上下交而其志同也。内阳而外阴，内健而外顺，内君子而外小人，君子道长，小人道消也。"
  },
  "image": {
    "zh_hant": "天地交，泰。后以財成天地之道，輔相天地之宜，以左右民。",
    "zh_hans": "天地交，泰。后以财成天地之道，辅相天地之宜，以左右民。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初九",
        "zh_hans": "初九"
      },
      "text": {
        "zh_hant": "拔茅茹以其彙。征吉。",
        "zh_hans": "拔茅茹以其汇。征吉。"
      },
      "xiao_xiang": {
        "zh_hant": "拔茅征吉、志在外也。",
        "zh_hans": "拔茅征吉、志在外也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "九二",
        "zh_hans": "九二"
      },
      "text": {
        "zh_hant": "苞荒，用馮河，不遐遺。朋亡，得尚于中行。",
        "zh_hans": "苞荒，用冯河，不遐遗。朋亡，得尚于中行。"
      },
      "xiao_xiang": {
        "zh_hant": "苞荒、得尚于中行，以光大也。",
        "zh_hans": "苞荒、得尚于中行，以光大也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "九三",
        "zh_hans": "九三"
      },
      "text": {
        "zh_hant": "无平不陂，无往不復。艱貞，无咎。勿恤其孚，于食有福。",
        "zh_hans": "无平不陂，无往不复。艰贞，无咎。勿恤其孚，于食有福。"
      },
      "xiao_xiang": {
        "zh_hant": "无往不復、天地際也。",
        "zh_hans": "无往不复、天地际也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "六四",
        "zh_hans": "六四"
      },
      "text": {
        "zh_hant": "翩翩，不富以其鄰，不戒以孚。",
        "zh_hans": "翩翩，不富以其邻，不戒以孚。"
      },
      "xiao_xiang": {
        "zh_hant": "翩翩不富、皆失實也，不戒以孚、中心願也。",
        "zh_hans": "翩翩不富、皆失实也，不戒以孚、中心愿也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "六五",
        "zh_hans": "六五"
      },
      "text": {
        "zh_hant": "帝乙歸妹，以祉，元吉。",
        "zh_hans": "帝乙归妹，以祉，元吉。"
      },
      "xiao_xiang": {
        "zh_hant": "以祉元吉、中以行願也。",
        "zh_hans": "以祉元吉、中以行愿也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上六",
        "zh_hans": "上六"
      },
      "text": {
        "zh_hant": "城復于隍，勿用師，自邑告命、貞吝。",
        "zh_hans": "城复于隍，勿用师，自邑告命、贞吝。"
      },
      "xiao_xiang": {
        "zh_hant": "城復于隍、其命亂也。",
        "zh_hans": "城复于隍、其命乱也。"
      }
    }
  ],
