  "name": {
    "zh_hant": "升",
    "zh_hans": "升",
    "pinyin": "shēng",
    "en": "Ascending"
  },
  "judgment": {
    "zh_hant": "元亨。用見大人，勿恤。南征吉。",
    "zh_hans": "元亨。用见大人，勿恤。南征吉。"
  },
  "tuan": {
    "zh_hant": "柔以時升，巽而順，剛中而應，是以大亨。用見大人勿恤、有慶也，南征吉、志行也。",
    "zh_hans": "柔以时升，巽而顺，刚中而应，是以大亨。用见大人勿恤、有庆也，南征吉、志行也。"
  },
  "image": {
    "zh_hant": "地中生木，升。君子以順德，積小以高大。",
    "zh_hans": "地中生木，升。君子以顺德，积小以高大。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初六",
        "zh_hans": "初六"
      },
      "text": {
        "zh_hant": "允升，大吉。",
        "zh_hans": "允升，大吉。"
      },
      "xiao_xiang": {
        "zh_hant": "允升大吉、上合志也。",
        "zh_hans": "允升大吉、上合志也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "九二",
        "zh_hans": "九二"
      },
      "text": {
        "zh_hant": "孚乃利用禴，无咎。",
        "zh_hans": "孚乃利用禴，无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "九二之孚、有喜也。",
        "zh_hans": "九二之孚、有喜也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "九三",
        "zh_hans": "九三"
      },
      "text": {
        "zh_hant": "升虛邑。",
        "zh_hans": "升虚邑。"
      },
      "xiao_xiang": {
        "zh_hant": "升虛邑、无所疑也。",
        "zh_hans": "升虚邑、无所疑也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "六四",
        "zh_hans": "六四"
      },
      "text": {
        "zh_hant": "王用亨于岐山，吉，无咎。",
        "zh_hans": "王用亨于岐山，吉，无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "王用亨于岐山、順事也。",
        "zh_hans": "王用亨于岐山、顺事也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "六五",
        "zh_hans": "六五"
      },
      "text": {
        "zh_hant": "貞吉，升階。",
        "zh_hans": "贞吉，升阶。"
      },
      "xiao_xiang": {
        "zh_hant": "貞吉升階、大得志也。",
        "zh_hans": "贞吉升阶、大得志也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上六",
        "zh_hans": "上六"
      },
      "text": {
        "zh_hant": "冥升，利于不息之貞。",
        "zh_hans": "冥升，利于不息之贞。"
      },
      "xiao_xiang": {
        "zh_hant": "冥升在上、消不富也。",
        "zh_hans": "冥升在上、消不富也。"
      }
    }
  ],
