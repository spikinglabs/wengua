{
  "number": 31,
  "unicode": "䷞",
  "binary": "001110",
  "trigrams": {
    "lower": "gen",
    "upper": "dui"
  },
  "name": {
    "zh_hant": "咸",
    "zh_hans": "咸",
    "pinyin": "xián",
    "en": "Influence"
  },
  "judgment": {
    "zh_hant": "亨。利貞。取女吉。",
    "zh_hans": "亨。利贞。取女吉。"
  },
  "tuan": {
    "zh_hant": "咸、感也。柔上而剛下，二氣感應以相與，止而說，男下女，是以亨利貞、取女吉也。天地感而萬物化生，聖人感人心而天下和平。觀其所感而天地萬物之情可見矣。",
    "zh_hans": "咸、感也。柔上而刚下，二气感应以相与，止而说，男下女，是以亨利贞、取女吉也。天地感而万物化生，圣人感人心而天下和平。观其所感而天地万物之情可见矣。"
  },
  "image": {
    "zh_hant": "山上有澤，咸。君子以虛受人。",
    "zh_hans": "山上有泽，咸。君子以虚受人。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初六",
        "zh_hans": "初六"
      },
      "text": {
        "zh_hant": "咸其拇。",
        "zh_hans": "咸其拇。"
      },
      "xiao_xiang": {
        "zh_hant": "咸其拇、志在外也。",
        "zh_hans": "咸其拇、志在外也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "六二",
        "zh_hans": "六二"
      },
      "text": {
        "zh_hant": "咸其腓，凶。居吉。",
        "zh_hans": "咸其腓，凶。居吉。"
      },
      "xiao_xiang": {
        "zh_hant": "雖凶居吉、順不害也。",
        "zh_hans": "虽凶居吉、顺不害也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "九三",
        "zh_hans": "九三"
      },
      "text": {
        "zh_hant": "咸其股，執其隨，往吝。",
        "zh_hans": "咸其股，执其随，往吝。"
      },
      "xiao_xiang": {
        "zh_hant": "咸其股、亦不處也，志在隨人、所執下也。",
        "zh_hans": "咸其股、亦不处也，志在随人、所执下也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "九四",
        "zh_hans": "九四"
      },
      "text": {
        "zh_hant": "貞吉。悔亡。憧憧往來，朋從爾思。",
        "zh_hans": "贞吉。悔亡。憧憧往来，朋从尔思。"
      },
      "xiao_xiang": {
        "zh_hant": "貞吉悔亡、未感害也，憧憧往來、未光大也。",
        "zh_hans": "贞吉悔亡、未感害也，憧憧往来、未光大也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "九五",
        "zh_hans": "九五"
      },
      "text": {
        "zh_hant": "咸其脢，无悔。",
        "zh_hans": "咸其脢，无悔。"
      },
      "xiao_xiang": {
        "zh_hant": "咸其脢、志末也。",
        "zh_hans": "咸其脢、志末也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上六",
        "zh_hans": "上六"
      },
      "text": {
        "zh_hant": "咸其輔頰舌。",
        "zh_hans": "咸其辅颊舌。"
      },
      "xiao_xiang": {
        "zh_hant": "咸其輔頰舌、滕口說也。",
        "zh_hans": "咸其辅颊舌、滕口说也。"
      }
    }
  ],
