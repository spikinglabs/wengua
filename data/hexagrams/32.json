  "name": {
    "zh_hant": "恒",
    "zh_hans": "恒",
    "pinyin": "héng",
    "en": "Duration"
  },
  "judgment": {
    "zh_hant": "亨。无咎。利貞。利有攸往。",
    "zh_hans": "亨。无咎。利贞。利有攸往。"
  },
  "tuan": {
    "zh_hant": "《恆》、久也。剛上而柔下。雷風相與。巽而動，剛柔皆應，《恆》。恆亨无咎利貞、久於其道也。天地之道恆久而不已也。利有攸往、終則有始也。日月得天而能久照，四時變化而能久成。聖人久於其道而天下化成。觀其所恆而天地萬物之情可見矣。",
    "zh_hans": "《恒》、久也。刚上而柔下。雷风相与。巽而动，刚柔皆应，《恒》。恒亨无咎利贞、久于其道也。天地之道恒久而不已也。利有攸往、终则有始也。日月得天而能久照，四时变化而能久成。圣人久于其道而天下化成。观其所恒而天地万物之情可见矣。"
  },
  "image": {
    "zh_hant": "雷風《恆》。君子以立不易方。",
    "zh_hans": "雷风《恒》。君子以立不易方。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初六",
        "zh_hans": "初六"
      },
      "text": {
        "zh_hant": "浚恆，貞凶，无攸利。",
        "zh_hans": "浚恒，贞凶，无攸利。"
      },
      "xiao_xiang": {
        "zh_hant": "浚恆之凶、始求深也。",
        "zh_hans": "浚恒之凶、始求深也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "九二",
        "zh_hans": "九二"
      },
      "text": {
        "zh_hant": "悔亡。",
        "zh_hans": "悔亡。"
      },
      "xiao_xiang": {
        "zh_hant": "九二悔亡、能久中也。",
        "zh_hans": "九二悔亡、能久中也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "九三",
        "zh_hans": "九三"
      },
      "text": {
        "zh_hant": "不恆其德，或承之羞，貞吝。",
        "zh_hans": "不恒其德，或承之羞，贞吝。"
      },
      "xiao_xiang": {
        "zh_hant": "不恆其德、无所容也。",
        "zh_hans": "不恒其德、无所容也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "九四",
        "zh_hans": "九四"
      },
      "text": {
        "zh_hant": "田无禽。",
        "zh_hans": "田无禽。"
      },
      "xiao_xiang": {
        "zh_hant": "久非其位，安得禽也。",
        "zh_hans": "久非其位，安得禽也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "六五",
        "zh_hans": "六五"
      },
      "text": {
        "zh_hant": "恆其德、貞，婦人吉，夫子凶。",
        "zh_hans": "恒其德、贞，妇人吉，夫子凶。"
      },
      "xiao_xiang": {
        "zh_hant": "婦人貞吉、從一而終也。夫子制義、從婦凶也。",
        "zh_hans": "妇人贞吉、从一而终也。夫子制义、从妇凶也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上六",
        "zh_hans": "上六"
      },
      "text": {
        "zh_hant": "振恆，凶。",
        "zh_hans": "振恒，凶。"
      },
      "xiao_xiang": {
        "zh_hant": "振恆在上、大无功也。",
        "zh_hans": "振恒在上、大无功也。"
      }
    }
  ],
