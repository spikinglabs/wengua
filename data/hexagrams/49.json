{
  "number": 49,
  "unicode": "䷰",
  "binary": "101110",
  "trigrams": {
    "lower": "li",
    "upper": "dui"
  },
  "name": {
    "zh_hant": "革",
    "zh_hans": "革",
    "pinyin": "gé",
    "en": "Revolution"
  },
  "judgment": {
    "zh_hant": "巳日乃孚。元亨，利貞，悔亡。",
    "zh_hans": "巳日乃孚。元亨，利贞，悔亡。"
  },
  "tuan": {
    "zh_hant": "革、水火相息，二女同居，其志不相得曰革。巳日乃孚，革而信之。文明以說，大亨以正。革而當，其悔乃亡。天地革而四時成，湯武革命，順乎天而應乎人。革之時大矣哉！",
    "zh_hans": "革、水火相息，二女同居，其志不相得曰革。巳日乃孚，革而信之。文明以说，大亨以正。革而当，其悔乃亡。天地革而四时成，汤武革命，顺乎天而应乎人。革之时大矣哉！"
  },
  "image": {
    "zh_hant": "澤中有火，革。君子以治厤明時。",
    "zh_hans": "泽中有火，革。君子以治历明时。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初九",
        "zh_hans": "初九"
      },
      "text": {
        "zh_hant": "鞏用黃牛之革。",
        "zh_hans": "巩用黄牛之革。"
      },
      "xiao_xiang": {
        "zh_hant": "鞏用黃牛、不可以有為也。",
        "zh_hans": "巩用黄牛、不可以有为也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "六二",
        "zh_hans": "六二"
      },
      "text": {
        "zh_hant": "巳日乃革之，征吉，无咎。",
        "zh_hans": "巳日乃革之，征吉，无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "巳日革之、行有嘉也。",
        "zh_hans": "巳日革之、行有嘉也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "九三",
        "zh_hans": "九三"
      },
      "text": {
        "zh_hant": "征凶。貞厲。革言三就有孚。",
        "zh_hans": "征凶。贞厉。革言三就有孚。"
      },
      "xiao_xiang": {
        "zh_hant": "革言三就、又何之矣。",
        "zh_hans": "革言三就、又何之矣。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "九四",
        "zh_hans": "九四"
      },
      "text": {
        "zh_hant": "悔亡。有孚改命吉。",
        "zh_hans": "悔亡。有孚改命吉。"
      },
      "xiao_xiang": {
        "zh_hant": "改命之吉、信志也。",
        "zh_hans": "改命之吉、信志也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "九五",
        "zh_hans": "九五"
      },
      "text": {
        "zh_hant": "大人虎變，未占有孚。",
        "zh_hans": "大人虎变，未占有孚。"
      },
      "xiao_xiang": {
        "zh_hant": "大人虎變、其文炳也。",
        "zh_hans": "大人虎变、其文炳也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上六",
        "zh_hans": "上六"
      },
      "text": {
        "zh_hant": "君子豹變，小人革面，征凶，居貞吉。",
        "zh_hans": "君子豹变，小人革面，征凶，居贞吉。"
      },
      "xiao_xiang": {
        "zh_hant": "君子豹變、其文蔚也，小人革面、順以從君也。",
        "zh_hans": "君子豹变、其文蔚也，小人革面、顺以从君也。"
      }
    }
  ],
