  },
  "name": {
    "zh_hant": "需",
    "zh_hans": "需",
    "pinyin": "xū",
    "en": "Waiting"
  },
  "judgment": {
    "zh_hant": "有孚，光亨。貞吉。利涉大川。",
    "zh_hans": "有孚，光亨。贞吉。利涉大川。"
  },
  "tuan": {
    "zh_hant": "需、須也。險在前也，剛健而不陷，其義不困窮矣。需、有孚、光亨、貞吉，位乎天位以正中也。利涉大川、往有功也。",
    "zh_hans": "需、须也。险在前也，刚健而不陷，其义不困穷矣。需、有孚、光亨、贞吉，位乎天位以正中也。利涉大川、往有功也。"
  },
  "image": {
    "zh_hant": "雲上於天，需。君子以飲食宴樂。",
    "zh_hans": "云上于天，需。君子以饮食宴乐。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初九",
        "zh_hans": "初九"
      },
      "text": {
        "zh_hant": "需于郊，利用恆，无咎。",
        "zh_hans": "需于郊，利用恒，无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "需于郊、不犯難行也。利用恆无咎、未失常也。",
        "zh_hans": "需于郊、不犯难行也。利用恒无咎、未失常也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "九二",
        "zh_hans": "九二"
      },
      "text": {
        "zh_hant": "需于沙，小有言，終吉。",
        "zh_hans": "需于沙，小有言，终吉。"
      },
      "xiao_xiang": {
        "zh_hant": "需于沙、行在中也。雖小有言、以吉終也。",
        "zh_hans": "需于沙、行在中也。虽小有言、以吉终也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "九三",
        "zh_hans": "九三"
      },
      "text": {
        "zh_hant": "需于泥，致寇至。",
        "zh_hans": "需于泥，致寇至。"
      },
      "xiao_xiang": {
        "zh_hant": "需于泥、災在外也。自我致寇、敬慎不敗也。",
        "zh_hans": "需于泥、灾在外也。自我致寇、敬慎不败也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "六四",
        "zh_hans": "六四"
      },
      "text": {
        "zh_hant": "需于血，出自穴。",
        "zh_hans": "需于血，出自穴。"
      },
      "xiao_xiang": {
        "zh_hant": "需于血、順以聽也。",
        "zh_hans": "需于血、顺以听也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "九五",
        "zh_hans": "九五"
      },
      "text": {
        "zh_hant": "需于酒食，貞吉。",
        "zh_hans": "需于酒食，贞吉。"
      },
      "xiao_xiang": {
        "zh_hant": "酒食貞吉、以中正也。",
        "zh_hans": "酒食贞吉、以中正也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上六",
        "zh_hans": "上六"
      },
      "text": {
        "zh_hant": "入于穴，有不速之客三人來，敬之終吉。",
        "zh_hans": "入于穴，有不速之客三人来，敬之终吉。"
      },
      "xiao_xiang": {
        "zh_hant": "不速之客來、敬之終吉也，雖不當位，未大失也。",
        "zh_hans": "不速之客来、敬之终吉也，虽不当位，未大失也。"
      }
    }
  ],
