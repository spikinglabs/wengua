{
  "number": 57,
  "unicode": "䷸",
  "binary": "011011",
  "trigrams": {
    "lower": "xun",
    "upper": "xun"
  },
  "name": {
    "zh_hant": "巽",
    "zh_hans": "巽",
    "pinyin": "xùn",
    "en": "Wind"
  },
  "judgment": {
    "zh_hant": "小亨。利有攸往。利見大人。",
    "zh_hans": "小亨。利有攸往。利见大人。"
  },
  "tuan": {
    "zh_hant": "重巽以申命。剛巽乎中正而志行。柔皆順乎剛，是以小亨、利有攸往、利見大人。",
    "zh_hans": "重巽以申命。刚巽乎中正而志行。柔皆顺乎刚，是以小亨、利有攸往、利见大人。"
  },
  "image": {
    "zh_hant": "隨風，巽。君子以申命行事。",
    "zh_hans": "随风，巽。君子以申命行事。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初六",
        "zh_hans": "初六"
      },
      "text": {
        "zh_hant": "進退。利武人之貞。",
        "zh_hans": "进退。利武人之贞。"
      },
      "xiao_xiang": {
        "zh_hant": "進退、志疑也，利武人之貞、志治也。",
        "zh_hans": "进退、志疑也，利武人之贞、志治也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "九二",
        "zh_hans": "九二"
      },
      "text": {
        "zh_hant": "巽在床下，用史巫、紛若吉、无咎。",
        "zh_hans": "巽在床下，用史巫、纷若吉、无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "紛若之吉、得中也。",
        "zh_hans": "纷若之吉、得中也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "九三",
        "zh_hans": "九三"
      },
      "text": {
        "zh_hant": "頻巽，吝。",
        "zh_hans": "频巽，吝。"
      },
      "xiao_xiang": {
        "zh_hant": "頻巽之吝、志窮也。",
        "zh_hans": "频巽之吝、志穷也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "六四",
        "zh_hans": "六四"
      },
      "text": {
        "zh_hant": "悔亡，田獲三品。",
        "zh_hans": "悔亡，田获三品。"
      },
      "xiao_xiang": {
        "zh_hant": "田獲三品、有功也。",
        "zh_hans": "田获三品、有功也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "九五",
        "zh_hans": "九五"
      },
      "text": {
        "zh_hant": "貞吉，悔亡，无不利，无初有終。先庚三日，後庚三日，吉。",
        "zh_hans": "贞吉，悔亡，无不利，无初有终。先庚三日，后庚三日，吉。"
      },
      "xiao_xiang": {
        "zh_hant": "九五之吉、位正中也。",
        "zh_hans": "九五之吉、位正中也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上九",
        "zh_hans": "上九"
      },
      "text": {
        "zh_hant": "巽在床下，喪其資斧，貞凶。",
        "zh_hans": "巽在床下，丧其资斧，贞凶。"
      },
      "xiao_xiang": {
        "zh_hant": "巽在床下、上窮也，喪其資斧、正乎凶也。",
        "zh_hans": "巽在床下、上穷也，丧其资斧、正乎凶也。"
      }
    }
  ],
