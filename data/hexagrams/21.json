  "name": {
    "zh_hant": "噬嗑",
    "zh_hans": "噬嗑",
    "pinyin": "shì kè",
    "en": "Biting Through"
  },
  "judgment": {
    "zh_hant": "亨。利用獄。",
    "zh_hans": "亨。利用狱。"
  },
  "tuan": {
    "zh_hant": "頤中有物曰噬嗑。噬嗑而亨，剛柔分，動而明，雷電合而章。柔得中而上行，雖不當位，利用獄也。",
    "zh_hans": "颐中有物曰噬嗑。噬嗑而亨，刚柔分，动而明，雷电合而章。柔得中而上行，虽不当位，利用狱也。"
  },
  "image": {
    "zh_hant": "雷電噬嗑。先王以明罰勑法。",
    "zh_hans": "雷电噬嗑。先王以明罚𠡠法。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初九",
        "zh_hans": "初九"
      },
      "text": {
        "zh_hant": "屨校滅趾，无咎。",
        "zh_hans": "屦校灭趾，无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "屨校滅趾、不行也。",
        "zh_hans": "屦校灭趾、不行也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "六二",
        "zh_hans": "六二"
      },
      "text": {
        "zh_hant": "噬膚滅鼻，无咎。",
        "zh_hans": "噬肤灭鼻，无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "噬膚滅鼻、乘剛也。",
        "zh_hans": "噬肤灭鼻、乘刚也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "六三",
        "zh_hans": "六三"
      },
      "text": {
        "zh_hant": "噬腊肉遇毒，小吝，无咎。",
        "zh_hans": "噬腊肉遇毒，小吝，无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "遇毒、位不當也。",
        "zh_hans": "遇毒、位不当也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "九四",
        "zh_hans": "九四"
      },
      "text": {
        "zh_hant": "噬乾胏，得金矢。利艱貞、吉。",
        "zh_hans": "噬乾胏，得金矢。利艰贞、吉。"
      },
      "xiao_xiang": {
        "zh_hant": "利艱貞吉、未光也。",
        "zh_hans": "利艰贞吉、未光也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "六五",
        "zh_hans": "六五"
      },
      "text": {
        "zh_hant": "噬乾肉，得黃金。貞厲无咎。",
        "zh_hans": "噬乾肉，得黄金。贞厉无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "貞厲无咎、得當也。",
        "zh_hans": "贞厉无咎、得当也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上九",
        "zh_hans": "上九"
      },
      "text": {
        "zh_hant": "何校滅耳，凶。",
        "zh_hans": "何校灭耳，凶。"
      },
      "xiao_xiang": {
        "zh_hant": "何校滅耳、聰不明也。",
        "zh_hans": "何校灭耳、聪不明也。"
      }
    }
  ],
