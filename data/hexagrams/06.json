{
  "number": 6,
  "unicode": "䷅",
  "binary": "010111",
  "trigrams": {
    "lower": "kan",
    "upper": "qian"
  },
  "name": {
    "zh_hant": "訟",
    "zh_hans": "讼",
    "pinyin": "sòng",
    "en": "Dispute"
  },
  "judgment": {
    "zh_hant": "有孚窒，惕，中吉，終凶。利見大人。不利涉大川。",
    "zh_hans": "有孚窒，惕，中吉，终凶。利见大人。不利涉大川。"
  },
  "tuan": {
    "zh_hant": "訟，上剛下險，險而健，訟。訟、有孚、窒、惕、中吉，剛來而得中也。終凶、訟不可成也。利見大人、尚中正也。不利涉大川、入于淵也。",
    "zh_hans": "讼，上刚下险，险而健，讼。讼、有孚、窒、惕、中吉，刚来而得中也。终凶、讼不可成也。利见大人、尚中正也。不利涉大川、入于渊也。"
  },
  "image": {
    "zh_hant": "天與水違行，訟。君子以作事謀始。",
    "zh_hans": "天与水违行，讼。君子以作事谋始。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初六",
        "zh_hans": "初六"
      },
      "text": {
        "zh_hant": "不永所事，小有言，終吉。",
        "zh_hans": "不永所事，小有言，终吉。"
      },
      "xiao_xiang": {
        "zh_hant": "不永所事、訟不可長也。雖小有言、其辯明也。",
        "zh_hans": "不永所事、讼不可长也。虽小有言、其辩明也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "九二",
        "zh_hans": "九二"
      },
      "text": {
        "zh_hant": "不克訟，歸而逋其邑，人三百戶无眚。",
        "zh_hans": "不克讼，归而逋其邑，人三百户无眚。"
      },
      "xiao_xiang": {
        "zh_hant": "不克訟、歸逋竄也。自下訟上，患至掇也。",
        "zh_hans": "不克讼、归逋窜也。自下讼上，患至掇也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "六三",
        "zh_hans": "六三"
      },
      "text": {
        "zh_hant": "食舊德，貞厲，終吉。或從王事无成。",
        "zh_hans": "食旧德，贞厉，终吉。或从王事无成。"
      },
      "xiao_xiang": {
        "zh_hant": "食舊德、從上吉也。",
        "zh_hans": "食旧德、从上吉也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "九四",
        "zh_hans": "九四"
      },
      "text": {
        "zh_hant": "不克訟，復即命，渝。安貞吉。",
        "zh_hans": "不克讼，复即命，渝。安贞吉。"
      },
      "xiao_xiang": {
        "zh_hant": "復即命、渝、安貞不失也。",
        "zh_hans": "复即命、渝、安贞不失也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "九五",
        "zh_hans": "九五"
      },
      "text": {
        "zh_hant": "訟元吉。",
        "zh_hans": "讼元吉。"
      },
      "xiao_xiang": {
        "zh_hant": "訟元吉、以中正也。",
        "zh_hans": "讼元吉、以中正也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上九",
        "zh_hans": "上九"
      },
      "text": {
        "zh_hant": "或錫之鞶、帶，終朝三褫之。",
        "zh_hans": "或锡之鞶、带，终朝三褫之。"
      },
      "xiao_xiang": {
        "zh_hant": "以訟受服、亦不足敬也。",
        "zh_hans": "以讼受服、亦不足敬也。"
      }
    }
  ],
