{
  "number": 36,
  "unicode": "䷣",
  "binary": "101000",
  "trigrams": {
    "lower": "li",
    "upper": "kun"
  },
  "name": {
    "zh_hant": "明夷",
    "zh_hans": "明夷",
    "pinyin": "míng yí",
    "en": "Darkening of the Light"
  },
  "judgment": {
    "zh_hant": "利艱貞。",
    "zh_hans": "利艰贞。"
  },
  "tuan": {
    "zh_hant": "明入地中，明夷。內文明而外柔順，以蒙大難，文王以之。利艱貞、晦其明也，內難而能正其志，箕子以之。",
    "zh_hans": "明入地中，明夷。内文明而外柔顺，以蒙大难，文王以之。利艰贞、晦其明也，内难而能正其志，箕子以之。"
  },
  "image": {
    "zh_hant": "明入地中，明夷。君子以莅眾用晦而明。",
    "zh_hans": "明入地中，明夷。君子以莅众用晦而明。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初九",
        "zh_hans": "初九"
      },
      "text": {
        "zh_hant": "明夷于飛，垂其翼。君子于行，三日不食。有攸往，主人有言。",
        "zh_hans": "明夷于飞，垂其翼。君子于行，三日不食。有攸往，主人有言。"
      },
      "xiao_xiang": {
        "zh_hant": "君子于行、義不食也。",
        "zh_hans": "君子于行、义不食也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "六二",
        "zh_hans": "六二"
      },
      "text": {
        "zh_hant": "明夷、夷于左股，用拯馬、壯吉。",
        "zh_hans": "明夷、夷于左股，用拯马、壮吉。"
      },
      "xiao_xiang": {
        "zh_hant": "六二之吉、順以則也。",
        "zh_hans": "六二之吉、顺以则也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "九三",
        "zh_hans": "九三"
      },
      "text": {
        "zh_hant": "明夷于南狩，得其大首，不可疾貞。",
        "zh_hans": "明夷于南狩，得其大首，不可疾贞。"
      },
      "xiao_xiang": {
        "zh_hant": "南狩之志、乃大得也。",
        "zh_hans": "南狩之志、乃大得也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "六四",
        "zh_hans": "六四"
      },
      "text": {
        "zh_hant": "入于左腹，獲明夷之心于出門庭。",
        "zh_hans": "入于左腹，获明夷之心于出门庭。"
      },
      "xiao_xiang": {
        "zh_hant": "入于左腹、獲心意也。",
        "zh_hans": "入于左腹、获心意也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "六五",
        "zh_hans": "六五"
      },
      "text": {
        "zh_hant": "箕子之明夷，利貞。",
        "zh_hans": "箕子之明夷，利贞。"
      },
      "xiao_xiang": {
        "zh_hant": "箕子之貞、明不可息也。",
        "zh_hans": "箕子之贞、明不可息也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上六",
        "zh_hans": "上六"
      },
      "text": {
        "zh_hant": "不明、晦。初登于天，後入于地。",
        "zh_hans": "不明、晦。初登于天，后入于地。"
      },
      "xiao_xiang": {
        "zh_hant": "初登于天、照四國也，後入于地、失則也。",
        "zh_hans": "初登于天、照四国也，后入于地、失则也。"
      }
    }
  ],
