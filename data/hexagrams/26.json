{
  "number": 26,
  "unicode": "䷙",
  "binary": "111001",
  "trigrams": {
    "lower": "qian",
    "upper": "gen"
  },
  "name": {
    "zh_hant": "大畜",
    "zh_hans": "大畜",
    "pinyin": "dà chù",
    "en": "Great Restraint"
  },
  "judgment": {
    "zh_hant": "利貞。不家食吉。利涉大川。",
    "zh_hans": "利贞。不家食吉。利涉大川。"
  },
  "tuan": {
    "zh_hant": "大畜，剛健篤實，煇光日新。其德剛上而尚賢，能止健，大正也，不家食吉、養賢也，利涉大川、應乎天也。",
    "zh_hans": "大畜，刚健笃实，𪸩光日新。其德刚上而尚贤，能止健，大正也，不家食吉、养贤也，利涉大川、应乎天也。"
  },
  "image": {
    "zh_hant": "天在山中，大畜。君子以多識前言往行以畜其德。",
    "zh_hans": "天在山中，大畜。君子以多识前言往行以畜其德。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初九",
        "zh_hans": "初九"
      },
      "text": {
        "zh_hant": "有厲，利已。",
        "zh_hans": "有厉，利已。"
      },
      "xiao_xiang": {
        "zh_hant": "有厲利已、不犯災也。",
        "zh_hans": "有厉利已、不犯灾也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "九二",
        "zh_hans": "九二"
      },
      "text": {
        "zh_hant": "輿說輹。",
        "zh_hans": "舆说輹。"
      },
      "xiao_xiang": {
        "zh_hant": "輿說輹、中无尤也。",
        "zh_hans": "舆说輹、中无尤也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "九三",
        "zh_hans": "九三"
      },
      "text": {
        "zh_hant": "良馬逐，利艱貞，曰閑輿衛，利有攸往。",
        "zh_hans": "良马逐，利艰贞，曰闲舆卫，利有攸往。"
      },
      "xiao_xiang": {
        "zh_hant": "利有攸往、上合志也。",
        "zh_hans": "利有攸往、上合志也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "六四",
        "zh_hans": "六四"
      },
      "text": {
        "zh_hant": "童牛之牿，元吉。",
        "zh_hans": "童牛之牿，元吉。"
      },
      "xiao_xiang": {
        "zh_hant": "六四元吉、有喜也。",
        "zh_hans": "六四元吉、有喜也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "六五",
        "zh_hans": "六五"
      },
      "text": {
        "zh_hant": "豶豕之牙，吉。",
        "zh_hans": "豮豕之牙，吉。"
      },
      "xiao_xiang": {
        "zh_hant": "六五之吉、有慶也。",
        "zh_hans": "六五之吉、有庆也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上九",
        "zh_hans": "上九"
      },
      "text": {
        "zh_hant": "何天之衢，亨。",
        "zh_hans": "何天之衢，亨。"
      },
      "xiao_xiang": {
        "zh_hant": "何天之衢、道大行也。",
        "zh_hans": "何天之衢、道大行也。"
      }
    }
  ],
