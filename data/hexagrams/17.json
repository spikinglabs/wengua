{
  "number": 17,
  "unicode": "䷐",
  "binary": "100110",
  "trigrams": {
    "lower": "zhen",
    "upper": "dui"
  },
  "name": {
    "zh_hant": "隨",
    "zh_hans": "随",
    "pinyin": "suí",
    "en": "Following"
  },
  "judgment": {
    "zh_hant": "元亨，利貞，无咎。",
    "zh_hans": "元亨，利贞，无咎。"
  },
  "tuan": {
    "zh_hant": "隨，剛來而下柔，動而說，隨。大亨、貞、无咎而天下隨之，隨之時義大矣哉！",
    "zh_hans": "随，刚来而下柔，动而说，随。大亨、贞、无咎而天下随之，随之时义大矣哉！"
  },
  "image": {
    "zh_hant": "澤中有雷，隨。君子以嚮晦入宴息。",
    "zh_hans": "泽中有雷，随。君子以向晦入宴息。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初九",
        "zh_hans": "初九"
      },
      "text": {
        "zh_hant": "官有渝，貞吉，出門交有功。",
        "zh_hans": "官有渝，贞吉，出门交有功。"
      },
      "xiao_xiang": {
        "zh_hant": "官有渝、從正吉也，出門交有功、不失也。",
        "zh_hans": "官有渝、从正吉也，出门交有功、不失也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "六二",
        "zh_hans": "六二"
      },
      "text": {
        "zh_hant": "係小子，失丈夫。",
        "zh_hans": "系小子，失丈夫。"
      },
      "xiao_xiang": {
        "zh_hant": "係小子、弗兼與也。",
        "zh_hans": "系小子、弗兼与也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "六三",
        "zh_hans": "六三"
      },
      "text": {
        "zh_hant": "係丈夫，失小子，隨有求、得。利居貞。",
        "zh_hans": "系丈夫，失小子，随有求、得。利居贞。"
      },
      "xiao_xiang": {
        "zh_hant": "係丈夫、志舍下也。",
        "zh_hans": "系丈夫、志舍下也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "九四",
        "zh_hans": "九四"
      },
      "text": {
        "zh_hant": "隨有獲，貞凶。有孚在道，以明，何咎？",
        "zh_hans": "随有获，贞凶。有孚在道，以明，何咎？"
      },
      "xiao_xiang": {
        "zh_hant": "隨有獲、其義凶也，有孚在道、明功也。",
        "zh_hans": "随有获、其义凶也，有孚在道、明功也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "九五",
        "zh_hans": "九五"
      },
      "text": {
        "zh_hant": "孚于嘉、吉。",
        "zh_hans": "孚于嘉、吉。"
      },
      "xiao_xiang": {
        "zh_hant": "孚于嘉吉、位正中也。",
        "zh_hans": "孚于嘉吉、位正中也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上六",
        "zh_hans": "上六"
      },
      "text": {
        "zh_hant": "拘係之乃從，維之，王用亨于西山。",
        "zh_hans": "拘系之乃从，维之，王用亨于西山。"
      },
      "xiao_xiang": {
        "zh_hant": "拘係之、上窮也。",
        "zh_hans": "拘系之、上穷也。"
      }
    }
  ],
