{
  "number": 43,
  "unicode": "䷪",
  "binary": "111110",
  "trigrams": {
    "lower": "qian",
    "upper": "dui"
  },
  "name": {
    "zh_hant": "夬",
    "zh_hans": "夬",
    "pinyin": "guài",
    "en": "Breakthrough"
  },
  "judgment": {
    "zh_hant": "揚于王庭，孚號有厲，告自邑。不利即戎，利有攸往。",
    "zh_hans": "扬于王庭，孚号有厉，告自邑。不利即戎，利有攸往。"
  },
  "tuan": {
    "zh_hant": "夬、決也，剛決柔也。健而說，決而和。揚于王庭、柔乘五剛也，孚號有厲、其危乃光也。告自邑不利即戎、所尚乃窮也，利有攸往、剛長乃終也。",
    "zh_hans": "夬、决也，刚决柔也。健而说，决而和。扬于王庭、柔乘五刚也，孚号有厉、其危乃光也。告自邑不利即戎、所尚乃穷也，利有攸往、刚长乃终也。"
  },
  "image": {
    "zh_hant": "澤上於天，夬。君子以施祿及下，居德則忌。",
    "zh_hans": "泽上于天，夬。君子以施禄及下，居德则忌。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初九",
        "zh_hans": "初九"
      },
      "text": {
        "zh_hant": "壯于前趾，往不勝，為咎。",
        "zh_hans": "壮于前趾，往不胜，为咎。"
      },
      "xiao_xiang": {
        "zh_hant": "不勝而往、咎也。",
        "zh_hans": "不胜而往、咎也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "九二",
        "zh_hans": "九二"
      },
      "text": {
        "zh_hant": "惕號，莫夜有戎，勿恤。",
        "zh_hans": "惕号，莫夜有戎，勿恤。"
      },
      "xiao_xiang": {
        "zh_hant": "有戎勿恤、得中道也。",
        "zh_hans": "有戎勿恤、得中道也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "九三",
        "zh_hans": "九三"
      },
      "text": {
        "zh_hant": "壯于頄，有凶。君子夬夬，獨行遇雨、若濡，有慍无咎。",
        "zh_hans": "壮于頄，有凶。君子夬夬，独行遇雨、若濡，有愠无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "君子夬夬、終无咎也。",
        "zh_hans": "君子夬夬、终无咎也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "九四",
        "zh_hans": "九四"
      },
      "text": {
        "zh_hant": "臀无膚，其行次且。牽羊悔亡。聞言不信。",
        "zh_hans": "臀无肤，其行次且。牵羊悔亡。闻言不信。"
      },
      "xiao_xiang": {
        "zh_hant": "其行次且、位不當也，聞言不信、聰不明也。",
        "zh_hans": "其行次且、位不当也，闻言不信、聪不明也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "九五",
        "zh_hans": "九五"
      },
      "text": {
        "zh_hant": "莧陸夬夬，中行无咎。",
        "zh_hans": "苋陆夬夬，中行无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "中行无咎、中未光也。",
        "zh_hans": "中行无咎、中未光也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上六",
        "zh_hans": "上六"
      },
      "text": {
        "zh_hant": "无號，終有凶。",
        "zh_hans": "无号，终有凶。"
      },
      "xiao_xiang": {
        "zh_hant": "无號之凶、終不可長也。",
        "zh_hans": "无号之凶、终不可长也。"
      }
    }
  ],
