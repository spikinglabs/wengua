{
  "number": 55,
  "unicode": "䷶",
  "binary": "101100",
  "trigrams": {
    "lower": "li",
    "upper": "zhen"
  },
  "name": {
    "zh_hant": "豐",
    "zh_hans": "丰",
    "pinyin": "fēng",
    "en": "Abundance"
  },
  "judgment": {
    "zh_hant": "亨，王假之。勿憂，宜日中。",
    "zh_hans": "亨，王假之。勿忧，宜日中。"
  },
  "tuan": {
    "zh_hant": "豐、大也。明以動，故豐。王假之、尚大也。勿憂宜日中、宜照天下也。日中則昃，月盈則食，天地盈虛，與時消息，而況於人乎，況於鬼神乎？",
    "zh_hans": "丰、大也。明以动，故丰。王假之、尚大也。勿忧宜日中、宜照天下也。日中则昃，月盈则食，天地盈虚，与时消息，而况于人乎，况于鬼神乎？"
  },
  "image": {
    "zh_hant": "雷電皆至，豐。君子以折獄致刑。",
    "zh_hans": "雷电皆至，丰。君子以折狱致刑。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初九",
        "zh_hans": "初九"
      },
      "text": {
        "zh_hant": "遇其配主，雖旬无咎，往有尚。",
        "zh_hans": "遇其配主，虽旬无咎，往有尚。"
      },
      "xiao_xiang": {
        "zh_hant": "雖旬无咎、過旬災也。",
        "zh_hans": "虽旬无咎、过旬灾也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "六二",
        "zh_hans": "六二"
      },
      "text": {
        "zh_hant": "豐其蔀，日中見斗。往得疑疾，有孚，發若吉。",
        "zh_hans": "丰其蔀，日中见斗。往得疑疾，有孚，发若吉。"
      },
      "xiao_xiang": {
        "zh_hant": "有孚發若、信以發志也。",
        "zh_hans": "有孚发若、信以发志也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "九三",
        "zh_hans": "九三"
      },
      "text": {
        "zh_hant": "豐其沛，日中見沬，折其右肱，无咎。",
        "zh_hans": "丰其沛，日中见沬，折其右肱，无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "豐其沛、不可大事也，折其右肱、終不可用也。",
        "zh_hans": "丰其沛、不可大事也，折其右肱、终不可用也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "九四",
        "zh_hans": "九四"
      },
      "text": {
        "zh_hant": "豐其蔀，日中見斗，遇其夷主，吉。",
        "zh_hans": "丰其蔀，日中见斗，遇其夷主，吉。"
      },
      "xiao_xiang": {
        "zh_hant": "豐其蔀、位不當也。日中見斗、幽不明也，遇其夷主、吉行也。",
        "zh_hans": "丰其蔀、位不当也。日中见斗、幽不明也，遇其夷主、吉行也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "六五",
        "zh_hans": "六五"
      },
      "text": {
        "zh_hant": "來章，有慶譽，吉。",
        "zh_hans": "来章，有庆誉，吉。"
      },
      "xiao_xiang": {
        "zh_hant": "六五之吉、有慶也。",
        "zh_hans": "六五之吉、有庆也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上六",
        "zh_hans": "上六"
      },
      "text": {
        "zh_hant": "豐其屋，蔀其家，闚其戶，闃其无人，三歲不覿，凶。",
        "zh_hans": "丰其屋，蔀其家，闚其户，阒其无人，三岁不觌，凶。"
      },
      "xiao_xiang": {
        "zh_hant": "豐其屋、天際翔也。闚其戶、闃其无人、自藏也。",
        "zh_hans": "丰其屋、天际翔也。闚其户、阒其无人、自藏也。"
      }
    }
  ],
