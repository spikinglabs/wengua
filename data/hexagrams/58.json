  "name": {
    "zh_hant": "兌",
    "zh_hans": "兑",
    "pinyin": "duì",
    "en": "Joy"
  },
  "judgment": {
    "zh_hant": "亨。利貞。",
    "zh_hans": "亨。利贞。"
  },
  "tuan": {
    "zh_hant": "兌、說也。剛中而柔外。說以利貞，是以順乎天而應乎人。說以先民，民忘其勞。說以犯難，民忘其死。說之大，民勸矣哉！",
    "zh_hans": "兑、说也。刚中而柔外。说以利贞，是以顺乎天而应乎人。说以先民，民忘其劳。说以犯难，民忘其死。说之大，民劝矣哉！"
  },
  "image": {
    "zh_hant": "麗澤，兌。君子以朋友講習。",
    "zh_hans": "丽泽，兑。君子以朋友讲习。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初九",
        "zh_hans": "初九"
      },
      "text": {
        "zh_hant": "和兌，吉。",
        "zh_hans": "和兑，吉。"
      },
      "xiao_xiang": {
        "zh_hant": "和兌之吉、行未疑也。",
        "zh_hans": "和兑之吉、行未疑也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "九二",
        "zh_hans": "九二"
      },
      "text": {
        "zh_hant": "孚兌，吉，悔亡。",
        "zh_hans": "孚兑，吉，悔亡。"
      },
      "xiao_xiang": {
        "zh_hant": "孚兌之吉、信志也。",
        "zh_hans": "孚兑之吉、信志也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "六三",
        "zh_hans": "六三"
      },
      "text": {
        "zh_hant": "來兌，凶。",
        "zh_hans": "来兑，凶。"
      },
      "xiao_xiang": {
        "zh_hant": "來兌之凶、位不當也。",
        "zh_hans": "来兑之凶、位不当也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "九四",
        "zh_hans": "九四"
      },
      "text": {
        "zh_hant": "商兌未寧，介疾有喜。",
        "zh_hans": "商兑未宁，介疾有喜。"
      },
      "xiao_xiang": {
        "zh_hant": "九四之喜、有慶也。",
        "zh_hans": "九四之喜、有庆也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "九五",
        "zh_hans": "九五"
      },
      "text": {
        "zh_hant": "孚于剝，有厲。",
        "zh_hans": "孚于剥，有厉。"
      },
      "xiao_xiang": {
        "zh_hant": "孚于剝、位正當也。",
        "zh_hans": "孚于剥、位正当也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上六",
        "zh_hans": "上六"
      },
      "text": {
        "zh_hant": "引兌。",
        "zh_hans": "引兑。"
      },
      "xiao_xiang": {
        "zh_hant": "上六、引兌、未光也。",
        "zh_hans": "上六、引兑、未光也。"
      }
    }
