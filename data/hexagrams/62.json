{
  "number": 62,
  "unicode": "䷽",
  "binary": "001100",
  "trigrams": {
    "lower": "gen",
    "upper": "zhen"
  },
  "name": {
    "zh_hant": "小過",
    "zh_hans": "小过",
    "pinyin": "xiǎo guò",
    "en": "Small Excess"
  },
  "judgment": {
    "zh_hant": "亨。利貞。可小事，不可大事。飛鳥遺之音，不宜上，宜下，大吉。",
    "zh_hans": "亨。利贞。可小事，不可大事。飞鸟遗之音，不宜上，宜下，大吉。"
  },
  "tuan": {
    "zh_hant": "小過亨、小者過而亨也。過以利貞、與時行也。柔得中，是以小事吉也。剛失位而不中，是以不可大事也。有飛鳥之象焉，飛鳥遺之音、不宜上、宜下、大吉、上逆而下順也。",
    "zh_hans": "小过亨、小者过而亨也。过以利贞、与时行也。柔得中，是以小事吉也。刚失位而不中，是以不可大事也。有飞鸟之象焉，飞鸟遗之音、不宜上、宜下、大吉、上逆而下顺也。"
  },
  "image": {
    "zh_hant": "山上有雷，小過。君子以行過乎恭，喪過乎哀，用過乎儉。",
    "zh_hans": "山上有雷，小过。君子以行过乎恭，丧过乎哀，用过乎俭。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初六",
        "zh_hans": "初六"
      },
      "text": {
        "zh_hant": "飛鳥以凶。",
        "zh_hans": "飞鸟以凶。"
      },
      "xiao_xiang": {
        "zh_hant": "飛鳥以凶、不可如何也。",
        "zh_hans": "飞鸟以凶、不可如何也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "六二",
        "zh_hans": "六二"
      },
      "text": {
        "zh_hant": "過其祖，遇其妣。不及其君，遇其臣。无咎。",
        "zh_hans": "过其祖，遇其妣。不及其君，遇其臣。无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "不及其君、臣不可過也。",
        "zh_hans": "不及其君、臣不可过也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "九三",
        "zh_hans": "九三"
      },
      "text": {
        "zh_hant": "弗過、防之，從或戕之，凶。",
        "zh_hans": "弗过、防之，从或戕之，凶。"
      },
      "xiao_xiang": {
        "zh_hant": "從或戕之、凶如何也？",
        "zh_hans": "从或戕之、凶如何也？"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "九四",
        "zh_hans": "九四"
      },
      "text": {
        "zh_hant": "无咎。弗過、遇之，往厲必戒。勿用永貞。",
        "zh_hans": "无咎。弗过、遇之，往厉必戒。勿用永贞。"
      },
      "xiao_xiang": {
        "zh_hant": "弗過遇之、位不當也。往厲必戒、終不可長也。",
        "zh_hans": "弗过遇之、位不当也。往厉必戒、终不可长也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "六五",
        "zh_hans": "六五"
      },
      "text": {
        "zh_hant": "密雲不雨，自我西郊。公弋取彼在穴。",
        "zh_hans": "密云不雨，自我西郊。公弋取彼在穴。"
      },
      "xiao_xiang": {
        "zh_hant": "密雲不雨、已上也。",
        "zh_hans": "密云不雨、已上也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上六",
        "zh_hans": "上六"
      },
      "text": {
        "zh_hant": "弗遇、過之，飛鳥離之，凶，是謂災眚。",
        "zh_hans": "弗遇、过之，飞鸟离之，凶，是谓灾眚。"
      },
      "xiao_xiang": {
        "zh_hant": "弗遇過之、已亢也。",
        "zh_hans": "弗遇过之、已亢也。"
      }
    }
  ],
