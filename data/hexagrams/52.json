  },
  "name": {
    "zh_hant": "艮",
    "zh_hans": "艮",
    "pinyin": "gèn",
    "en": "Stillness"
  },
  "judgment": {
    "zh_hant": "艮其背，不獲其身，行其庭，不見其人，无咎。",
    "zh_hans": "艮其背，不获其身，行其庭，不见其人，无咎。"
  },
  "tuan": {
    "zh_hant": "艮、止也。時止則止，時行則行，動靜不失其時，其道光明。艮其止，止其所也。上下敵應，不相與也。是以不獲其身、行其庭不見其人，无咎也。",
    "zh_hans": "艮、止也。时止则止，时行则行，动静不失其时，其道光明。艮其止，止其所也。上下敌应，不相与也。是以不获其身、行其庭不见其人，无咎也。"
  },
  "image": {
    "zh_hant": "兼山，艮。君子以思不出其位。",
    "zh_hans": "兼山，艮。君子以思不出其位。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初六",
        "zh_hans": "初六"
      },
      "text": {
        "zh_hant": "艮其趾，无咎。利永貞。",
        "zh_hans": "艮其趾，无咎。利永贞。"
      },
      "xiao_xiang": {
        "zh_hant": "艮其趾、未失正也。",
        "zh_hans": "艮其趾、未失正也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "六二",
        "zh_hans": "六二"
      },
      "text": {
        "zh_hant": "艮其腓，不拯其隨，其心不快。",
        "zh_hans": "艮其腓，不拯其随，其心不快。"
      },
      "xiao_xiang": {
        "zh_hant": "不拯其隨、未退聽也。",
        "zh_hans": "不拯其随、未退听也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "九三",
        "zh_hans": "九三"
      },
      "text": {
        "zh_hant": "艮其限，列其夤，厲薰心。",
        "zh_hans": "艮其限，列其夤，厉薰心。"
      },
      "xiao_xiang": {
        "zh_hant": "艮其限、危薰心也。",
        "zh_hans": "艮其限、危薰心也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "六四",
        "zh_hans": "六四"
      },
      "text": {
        "zh_hant": "艮其身，无咎。",
        "zh_hans": "艮其身，无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "艮其身、止諸躬也。",
        "zh_hans": "艮其身、止诸躬也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "六五",
        "zh_hans": "六五"
      },
      "text": {
        "zh_hant": "艮其輔，言有序，悔亡。",
        "zh_hans": "艮其辅，言有序，悔亡。"
      },
      "xiao_xiang": {
        "zh_hant": "艮其輔、以中正也。",
        "zh_hans": "艮其辅、以中正也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上九",
        "zh_hans": "上九"
      },
      "text": {
        "zh_hant": "敦艮，吉。",
        "zh_hans": "敦艮，吉。"
      },
      "xiao_xiang": {
        "zh_hant": "敦艮之吉、以厚終也。",
        "zh_hans": "敦艮之吉、以厚终也。"
      }
    }
  ],
