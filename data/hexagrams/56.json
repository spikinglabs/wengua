{
  "number": 56,
  "unicode": "䷷",
  "binary": "001101",
  "trigrams": {
    "lower": "gen",
    "upper": "li"
  },
  "name": {
    "zh_hant": "旅",
    "zh_hans": "旅",
    "pinyin": "lǚ",
    "en": "The Wanderer"
  },
  "judgment": {
    "zh_hant": "小亨。旅貞吉。",
    "zh_hans": "小亨。旅贞吉。"
  },
  "tuan": {
    "zh_hant": "旅小亨，柔得中乎外而順乎剛，止而麗乎明，是以小亨旅貞吉也。旅之時義大矣哉！",
    "zh_hans": "旅小亨，柔得中乎外而顺乎刚，止而丽乎明，是以小亨旅贞吉也。旅之时义大矣哉！"
  },
  "image": {
    "zh_hant": "山上有火，旅。君子以明慎用刑而不留獄。",
    "zh_hans": "山上有火，旅。君子以明慎用刑而不留狱。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初六",
        "zh_hans": "初六"
      },
      "text": {
        "zh_hant": "旅瑣瑣斯，其所取災。",
        "zh_hans": "旅琐琐斯，其所取灾。"
      },
      "xiao_xiang": {
        "zh_hant": "旅瑣瑣、志窮災也。",
        "zh_hans": "旅琐琐、志穷灾也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "六二",
        "zh_hans": "六二"
      },
      "text": {
        "zh_hant": "旅即次，懷其資，得童僕貞。",
        "zh_hans": "旅即次，怀其资，得童仆贞。"
      },
      "xiao_xiang": {
        "zh_hant": "得童僕貞，終无尤也。",
        "zh_hans": "得童仆贞，终无尤也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "九三",
        "zh_hans": "九三"
      },
      "text": {
        "zh_hant": "旅焚其次，喪其童僕貞，厲。",
        "zh_hans": "旅焚其次，丧其童仆贞，厉。"
      },
      "xiao_xiang": {
        "zh_hant": "旅焚其次，亦以傷矣。以旅與下，其義喪也。",
        "zh_hans": "旅焚其次，亦以伤矣。以旅与下，其义丧也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "九四",
        "zh_hans": "九四"
      },
      "text": {
        "zh_hant": "旅于處，得其資斧，我心不快。",
        "zh_hans": "旅于处，得其资斧，我心不快。"
      },
      "xiao_xiang": {
        "zh_hant": "旅于處、未得位也。得其資斧、心未快也。",
        "zh_hans": "旅于处、未得位也。得其资斧、心未快也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "六五",
        "zh_hans": "六五"
      },
      "text": {
        "zh_hant": "射雉一矢亡，終以譽命。",
        "zh_hans": "射雉一矢亡，终以誉命。"
      },
      "xiao_xiang": {
        "zh_hant": "終以譽命、上逮也。",
        "zh_hans": "终以誉命、上逮也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上九",
        "zh_hans": "上九"
      },
      "text": {
        "zh_hant": "鳥焚其巢，旅人先笑後號咷。喪牛于易，凶。",
        "zh_hans": "鸟焚其巢，旅人先笑后号咷。丧牛于易，凶。"
      },
      "xiao_xiang": {
        "zh_hant": "以旅在上、其義焚也，喪牛于易、終莫之聞也。",
        "zh_hans": "以旅在上、其义焚也，丧牛于易、终莫之闻也。"
      }
    }
  ],
