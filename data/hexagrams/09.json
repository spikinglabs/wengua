{
  "number": 9,
  "unicode": "䷈",
  "binary": "111011",
  "trigrams": {
    "lower": "qian",
    "upper": "xun"
  },
  "name": {
    "zh_hant": "小畜",
    "zh_hans": "小畜",
    "pinyin": "xiǎo chù",
    "en": "Small Restraint"
  },
  "judgment": {
    "zh_hant": "亨。密雲不雨，自我西郊。",
    "zh_hans": "亨。密云不雨，自我西郊。"
  },
  "tuan": {
    "zh_hant": "小畜，柔得位而上下應之，曰小畜。健而巽，剛中而志行，乃亨。密雲不雨、尚往也，自我西郊、施未行也。",
    "zh_hans": "小畜，柔得位而上下应之，曰小畜。健而巽，刚中而志行，乃亨。密云不雨、尚往也，自我西郊、施未行也。"
  },
  "image": {
    "zh_hant": "風行天上，小畜。君子以懿文德。",
    "zh_hans": "风行天上，小畜。君子以懿文德。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初九",
        "zh_hans": "初九"
      },
      "text": {
        "zh_hant": "復自道，何其咎，吉。",
        "zh_hans": "复自道，何其咎，吉。"
      },
      "xiao_xiang": {
        "zh_hant": "復自道、其義吉也。",
        "zh_hans": "复自道、其义吉也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "九二",
        "zh_hans": "九二"
      },
      "text": {
        "zh_hant": "牽復，吉。",
        "zh_hans": "牵复，吉。"
      },
      "xiao_xiang": {
        "zh_hant": "牽復在中、亦不自失也。",
        "zh_hans": "牵复在中、亦不自失也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "九三",
        "zh_hans": "九三"
      },
      "text": {
        "zh_hant": "輿說輻。夫妻反目。",
        "zh_hans": "舆说辐。夫妻反目。"
      },
      "xiao_xiang": {
        "zh_hant": "夫妻反目、不能正室也。",
        "zh_hans": "夫妻反目、不能正室也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "六四",
        "zh_hans": "六四"
      },
      "text": {
        "zh_hant": "有孚血去惕出，无咎。",
        "zh_hans": "有孚血去惕出，无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "有孚惕出、上合志也。",
        "zh_hans": "有孚惕出、上合志也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "九五",
        "zh_hans": "九五"
      },
      "text": {
        "zh_hant": "有孚攣如，富以其鄰。",
        "zh_hans": "有孚挛如，富以其邻。"
      },
      "xiao_xiang": {
        "zh_hant": "有孚攣如、不獨富也。",
        "zh_hans": "有孚挛如、不独富也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上九",
        "zh_hans": "上九"
      },
      "text": {
        "zh_hant": "既雨既處，尚德載。婦貞厲。月幾望，君子征凶。",
        "zh_hans": "既雨既处，尚德载。妇贞厉。月几望，君子征凶。"
      },
      "xiao_xiang": {
        "zh_hant": "既雨既處、德積載也。君子征凶、有所疑也。",
        "zh_hans": "既雨既处、德积载也。君子征凶、有所疑也。"
      }
    }
  ],
