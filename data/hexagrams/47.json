{
  "number": 47,
  "unicode": "䷮",
  "binary": "010110",
  "trigrams": {
    "lower": "kan",
    "upper": "dui"
  },
  "name": {
    "zh_hant": "困",
    "zh_hans": "困",
    "pinyin": "kùn",
    "en": "Exhaustion"
  },
  "judgment": {
    "zh_hant": "亨。貞大人吉，无咎。有言不信。",
    "zh_hans": "亨。贞大人吉，无咎。有言不信。"
  },
  "tuan": {
    "zh_hant": "困、剛揜也。險以說，困而不失其所，亨，其唯君子乎。貞大人吉、以剛中也，有言不信、尚口乃窮也。",
    "zh_hans": "困、刚揜也。险以说，困而不失其所，亨，其唯君子乎。贞大人吉、以刚中也，有言不信、尚口乃穷也。"
  },
  "image": {
    "zh_hant": "澤无水，困。君子以致命遂志。",
    "zh_hans": "泽无水，困。君子以致命遂志。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初六",
        "zh_hans": "初六"
      },
      "text": {
        "zh_hant": "臀困于株木，入于幽谷，三歲不覿。",
        "zh_hans": "臀困于株木，入于幽谷，三岁不觌。"
      },
      "xiao_xiang": {
        "zh_hant": "入于幽谷，幽、不明也。",
        "zh_hans": "入于幽谷，幽、不明也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "九二",
        "zh_hans": "九二"
      },
      "text": {
        "zh_hant": "困于酒食，朱紱方來。利用享祀。征凶无咎。",
        "zh_hans": "困于酒食，朱绂方来。利用享祀。征凶无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "困于酒食、中有慶也。",
        "zh_hans": "困于酒食、中有庆也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "六三",
        "zh_hans": "六三"
      },
      "text": {
        "zh_hant": "困于石，據于蒺蔾，入于其宮，不見其妻，凶。",
        "zh_hans": "困于石，据于蒺蔾，入于其宫，不见其妻，凶。"
      },
      "xiao_xiang": {
        "zh_hant": "據于蒺蔾、乘剛也，入于其宮不見其妻、不祥也。",
        "zh_hans": "据于蒺蔾、乘刚也，入于其宫不见其妻、不祥也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "九四",
        "zh_hans": "九四"
      },
      "text": {
        "zh_hant": "來徐徐，困于金車，吝，有終。",
        "zh_hans": "来徐徐，困于金车，吝，有终。"
      },
      "xiao_xiang": {
        "zh_hant": "來徐徐、志在下也。雖不當位，有與也。",
        "zh_hans": "来徐徐、志在下也。虽不当位，有与也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "九五",
        "zh_hans": "九五"
      },
      "text": {
        "zh_hant": "劓刖，困于赤紱，乃徐有說，利用祭祀。",
        "zh_hans": "劓刖，困于赤绂，乃徐有说，利用祭祀。"
      },
      "xiao_xiang": {
        "zh_hant": "劓刖、志未得也，乃徐有說、以中直也，利用祭祀、受福也。",
        "zh_hans": "劓刖、志未得也，乃徐有说、以中直也，利用祭祀、受福也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上六",
        "zh_hans": "上六"
      },
      "text": {
        "zh_hant": "困于葛藟，于臲卼，曰動悔有悔，征吉。",
        "zh_hans": "困于葛藟，于臲卼，曰动悔有悔，征吉。"
      },
      "xiao_xiang": {
        "zh_hant": "困于葛藟、未當也，動悔有悔、吉行也。",
        "zh_hans": "困于葛藟、未当也，动悔有悔、吉行也。"
      }
    }
  ],
