{
  "number": 34,
  "unicode": "䷡",
  "binary": "111100",
  "trigrams": {
    "lower": "qian",
    "upper": "zhen"
  },
  "name": {
    "zh_hant": "大壯",
    "zh_hans": "大壮",
    "pinyin": "dà zhuàng",
    "en": "Great Strength"
  },
  "judgment": {
    "zh_hant": "利貞。",
    "zh_hans": "利贞。"
  },
  "tuan": {
    "zh_hant": "大壯、大者壯也。剛以動，故壯。大壯利貞，大者、正也。正大而天地之情可見矣。",
    "zh_hans": "大壮、大者壮也。刚以动，故壮。大壮利贞，大者、正也。正大而天地之情可见矣。"
  },
  "image": {
    "zh_hant": "雷在天上，大壯。君子以非禮弗履。",
    "zh_hans": "雷在天上，大壮。君子以非礼弗履。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初九",
        "zh_hans": "初九"
      },
      "text": {
        "zh_hant": "壯于趾，征凶有孚。",
        "zh_hans": "壮于趾，征凶有孚。"
      },
      "xiao_xiang": {
        "zh_hant": "壯于趾、其孚窮也。",
        "zh_hans": "壮于趾、其孚穷也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "九二",
        "zh_hans": "九二"
      },
      "text": {
        "zh_hant": "貞吉。",
        "zh_hans": "贞吉。"
      },
      "xiao_xiang": {
        "zh_hant": "九二貞吉、以中也。",
        "zh_hans": "九二贞吉、以中也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "九三",
        "zh_hans": "九三"
      },
      "text": {
        "zh_hant": "小人用壯，君子用罔，貞厲。羝羊觸藩，羸其角。",
        "zh_hans": "小人用壮，君子用罔，贞厉。羝羊触藩，羸其角。"
      },
      "xiao_xiang": {
        "zh_hant": "小人用壯、君子用罔也。",
        "zh_hans": "小人用壮、君子用罔也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "九四",
        "zh_hans": "九四"
      },
      "text": {
        "zh_hant": "貞吉，悔亡。藩決不羸，壯于大輿之輹。",
        "zh_hans": "贞吉，悔亡。藩决不羸，壮于大舆之輹。"
      },
      "xiao_xiang": {
        "zh_hant": "藩決不羸、尚往也。",
        "zh_hans": "藩决不羸、尚往也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "六五",
        "zh_hans": "六五"
      },
      "text": {
        "zh_hant": "喪羊于易，无悔。",
        "zh_hans": "丧羊于易，无悔。"
      },
      "xiao_xiang": {
        "zh_hant": "喪羊于易、位不當也。",
        "zh_hans": "丧羊于易、位不当也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上六",
        "zh_hans": "上六"
      },
      "text": {
        "zh_hant": "羝羊觸藩，不能退，不能遂，无攸利，艱則吉。",
        "zh_hans": "羝羊触藩，不能退，不能遂，无攸利，艰则吉。"
      },
      "xiao_xiang": {
        "zh_hant": "不能退、不能遂、不詳也，艱則吉、咎不長也。",
        "zh_hans": "不能退、不能遂、不详也，艰则吉、咎不长也。"
      }
    }
  ],
