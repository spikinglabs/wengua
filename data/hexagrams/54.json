{
  "number": 54,
  "unicode": "䷵",
  "binary": "110100",
  "trigrams": {
    "lower": "dui",
    "upper": "zhen"
  },
  "name": {
    "zh_hant": "歸妹",
    "zh_hans": "归妹",
    "pinyin": "guī mèi",
    "en": "The Marrying Maiden"
  },
  "judgment": {
    "zh_hant": "征凶，无攸利。",
    "zh_hans": "征凶，无攸利。"
  },
  "tuan": {
    "zh_hant": "歸妹、天地之大義也。天地不交而萬物不興。歸妹、人之終始也。說以動，所歸妹也。征凶、位不當也，无攸利、柔乘剛也。",
    "zh_hans": "归妹、天地之大义也。天地不交而万物不兴。归妹、人之终始也。说以动，所归妹也。征凶、位不当也，无攸利、柔乘刚也。"
  },
  "image": {
    "zh_hant": "澤上有雷，歸妹。君子以永終知敝。",
    "zh_hans": "泽上有雷，归妹。君子以永终知敝。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初九",
        "zh_hans": "初九"
      },
      "text": {
        "zh_hant": "歸妹以娣。跛能履，征吉。",
        "zh_hans": "归妹以娣。跛能履，征吉。"
      },
      "xiao_xiang": {
        "zh_hant": "歸妹以娣、以恆也，跛能履、吉相承也。",
        "zh_hans": "归妹以娣、以恒也，跛能履、吉相承也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "九二",
        "zh_hans": "九二"
      },
      "text": {
        "zh_hant": "眇能視，利幽人之貞。",
        "zh_hans": "眇能视，利幽人之贞。"
      },
      "xiao_xiang": {
        "zh_hant": "利幽人之貞、未變常也。",
        "zh_hans": "利幽人之贞、未变常也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "六三",
        "zh_hans": "六三"
      },
      "text": {
        "zh_hant": "歸妹以須，反歸以娣。",
        "zh_hans": "归妹以须，反归以娣。"
      },
      "xiao_xiang": {
        "zh_hant": "歸妹以須、未當也。",
        "zh_hans": "归妹以须、未当也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "九四",
        "zh_hans": "九四"
      },
      "text": {
        "zh_hant": "歸妹愆期，遲歸有時。",
        "zh_hans": "归妹愆期，迟归有时。"
      },
      "xiao_xiang": {
        "zh_hant": "愆期之志、有待而行也。",
        "zh_hans": "愆期之志、有待而行也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "六五",
        "zh_hans": "六五"
      },
      "text": {
        "zh_hant": "帝乙歸妹，其君之袂不如其娣之袂良。月幾望、吉。",
        "zh_hans": "帝乙归妹，其君之袂不如其娣之袂良。月几望、吉。"
      },
      "xiao_xiang": {
        "zh_hant": "帝乙歸妹、不如其娣之袂良也。其位在中，以貴行也。",
        "zh_hans": "帝乙归妹、不如其娣之袂良也。其位在中，以贵行也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上六",
        "zh_hans": "上六"
      },
      "text": {
        "zh_hant": "女承筐，无實，士刲羊，无血，无攸利。",
        "zh_hans": "女承筐，无实，士刲羊，无血，无攸利。"
      },
      "xiao_xiang": {
        "zh_hant": "上六无實、承虛筐也。",
        "zh_hans": "上六无实、承虚筐也。"
      }
    }
  ],
