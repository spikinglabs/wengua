{
  "number": 64,
  "unicode": "䷿",
  "binary": "010101",
  "trigrams": {
    "lower": "kan",
    "upper": "li"
  },
  "name": {
    "zh_hant": "未濟",
    "zh_hans": "未济",
    "pinyin": "wèi jì",
    "en": "Before Completion"
  },
  "judgment": {
    "zh_hant": "亨。小狐汔濟，濡其尾，无攸利。",
    "zh_hans": "亨。小狐汔济，濡其尾，无攸利。"
  },
  "tuan": {
    "zh_hant": "未濟亨、柔得中也。小狐汔濟、未出中也。濡其尾、无攸利、不續終也。雖不當位、剛柔應也。",
    "zh_hans": "未济亨、柔得中也。小狐汔济、未出中也。濡其尾、无攸利、不续终也。虽不当位、刚柔应也。"
  },
  "image": {
    "zh_hant": "火在水上，未濟。君子以慎辨物居方。",
    "zh_hans": "火在水上，未济。君子以慎辨物居方。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初六",
        "zh_hans": "初六"
      },
      "text": {
        "zh_hant": "濡其尾，吝。",
        "zh_hans": "濡其尾，吝。"
      },
      "xiao_xiang": {
        "zh_hant": "濡其尾、亦不知極也。",
        "zh_hans": "濡其尾、亦不知极也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "九二",
        "zh_hans": "九二"
      },
      "text": {
        "zh_hant": "曳其輪，貞吉。",
        "zh_hans": "曳其轮，贞吉。"
      },
      "xiao_xiang": {
        "zh_hant": "九二貞吉、中以行直也。",
        "zh_hans": "九二贞吉、中以行直也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "六三",
        "zh_hans": "六三"
      },
      "text": {
        "zh_hant": "未濟，征凶。利涉大川。",
        "zh_hans": "未济，征凶。利涉大川。"
      },
      "xiao_xiang": {
        "zh_hant": "未濟征凶、位不當也。",
        "zh_hans": "未济征凶、位不当也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "九四",
        "zh_hans": "九四"
      },
      "text": {
        "zh_hant": "貞吉，悔亡，震用伐鬼方，三年，有賞于大國。",
        "zh_hans": "贞吉，悔亡，震用伐鬼方，三年，有赏于大国。"
      },
      "xiao_xiang": {
        "zh_hant": "貞吉悔亡、志行也。",
        "zh_hans": "贞吉悔亡、志行也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "六五",
        "zh_hans": "六五"
      },
      "text": {
        "zh_hant": "貞吉，无悔。君子之光，有孚、吉。",
        "zh_hans": "贞吉，无悔。君子之光，有孚、吉。"
      },
      "xiao_xiang": {
        "zh_hant": "君子之光、其暉吉也。",
        "zh_hans": "君子之光、其晖吉也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上九",
        "zh_hans": "上九"
      },
      "text": {
        "zh_hant": "有孚于飲酒，无咎。濡其首，有孚失是。",
        "zh_hans": "有孚于饮酒，无咎。濡其首，有孚失是。"
      },
      "xiao_xiang": {
        "zh_hant": "飲酒濡首、亦不知節也。",
        "zh_hans": "饮酒濡首、亦不知节也。"
      }
    }
  ],
  "variants": [
