{
  "number": 51,
  "unicode": "䷲",
  "binary": "100100",
  "trigrams": {
    "lower": "zhen",
    "upper": "zhen"
  },
  "name": {
    "zh_hant": "震",
    "zh_hans": "震",
    "pinyin": "zhèn",
    "en": "Thunder"
  },
  "judgment": {
    "zh_hant": "亨。震來虩虩，笑言啞啞，震驚百里，不喪匕鬯。",
    "zh_hans": "亨。震来虩虩，笑言哑哑，震惊百里，不丧匕鬯。"
  },
  "tuan": {
    "zh_hant": "震亨。震來虩虩、恐致福也，笑言啞啞、後有則也，震驚百里、驚遠而懼邇也。不喪匕鬯、出可以守宗廟社稷，以為祭主也。",
    "zh_hans": "震亨。震来虩虩、恐致福也，笑言哑哑、后有则也，震惊百里、惊远而惧迩也。不丧匕鬯、出可以守宗庙社稷，以为祭主也。"
  },
  "image": {
    "zh_hant": "洊雷、震。君子以恐懼脩省。",
    "zh_hans": "洊雷、震。君子以恐惧修省。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初九",
        "zh_hans": "初九"
      },
      "text": {
        "zh_hant": "「震來虩虩」，後「笑言啞啞」，吉。",
        "zh_hans": "「震来虩虩」，后「笑言哑哑」，吉。"
      },
      "xiao_xiang": {
        "zh_hant": "震來虩虩、恐致福也，笑言啞啞、後有則也。",
        "zh_hans": "震来虩虩、恐致福也，笑言哑哑、后有则也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "六二",
        "zh_hans": "六二"
      },
      "text": {
        "zh_hant": "震來厲，億喪貝，躋于九陵，勿逐，七日得。",
        "zh_hans": "震来厉，亿丧贝，跻于九陵，勿逐，七日得。"
      },
      "xiao_xiang": {
        "zh_hant": "震來厲、乘剛也。",
        "zh_hans": "震来厉、乘刚也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "六三",
        "zh_hans": "六三"
      },
      "text": {
        "zh_hant": "震蘇蘇，震行无眚。",
        "zh_hans": "震苏苏，震行无眚。"
      },
      "xiao_xiang": {
        "zh_hant": "震蘇蘇、位不當也。",
        "zh_hans": "震苏苏、位不当也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "九四",
        "zh_hans": "九四"
      },
      "text": {
        "zh_hant": "震遂泥。",
        "zh_hans": "震遂泥。"
      },
      "xiao_xiang": {
        "zh_hant": "震遂泥、未光也。",
        "zh_hans": "震遂泥、未光也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "六五",
        "zh_hans": "六五"
      },
      "text": {
        "zh_hant": "震往來厲，意无喪有事。",
        "zh_hans": "震往来厉，意无丧有事。"
      },
      "xiao_xiang": {
        "zh_hant": "震往來厲、危行也，其事在中、大无喪也。",
        "zh_hans": "震往来厉、危行也，其事在中、大无丧也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上六",
        "zh_hans": "上六"
      },
      "text": {
        "zh_hant": "震索索，視矍矍，征凶。震不于其躬、于其鄰、无咎。婚媾有言。",
        "zh_hans": "震索索，视矍矍，征凶。震不于其躬、于其邻、无咎。婚媾有言。"
      },
      "xiao_xiang": {
        "zh_hant": "震索索、中未得也，雖凶无咎、畏鄰戒也。",
        "zh_hans": "震索索、中未得也，虽凶无咎、畏邻戒也。"
      }
    }
  ],
