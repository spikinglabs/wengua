{
  "number": 25,
  "unicode": "䷘",
  "binary": "100111",
  "trigrams": {
    "lower": "zhen",
    "upper": "qian"
  },
  "name": {
    "zh_hant": "无妄",
    "zh_hans": "无妄",
    "pinyin": "wú wàng",
    "en": "Innocence"
  },
  "judgment": {
    "zh_hant": "元亨，利貞。其匪正有眚，不利有攸往。",
    "zh_hans": "元亨，利贞。其匪正有眚，不利有攸往。"
  },
  "tuan": {
    "zh_hant": "无妄，剛自外來而為主於內，動而健，剛中而應。大亨以正，天之命也。其匪正有眚、不利有攸往，无妄之往何之矣？天命不祐，行矣哉！",
    "zh_hans": "无妄，刚自外来而为主于内，动而健，刚中而应。大亨以正，天之命也。其匪正有眚、不利有攸往，无妄之往何之矣？天命不祐，行矣哉！"
  },
  "image": {
    "zh_hant": "天下雷行，物與无妄。先王以茂對時育萬物。",
    "zh_hans": "天下雷行，物与无妄。先王以茂对时育万物。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初九",
        "zh_hans": "初九"
      },
      "text": {
        "zh_hant": "无妄，往吉。",
        "zh_hans": "无妄，往吉。"
      },
      "xiao_xiang": {
        "zh_hant": "无妄之往、得志也。",
        "zh_hans": "无妄之往、得志也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "六二",
        "zh_hans": "六二"
      },
      "text": {
        "zh_hant": "不耕穫；不菑畬；則利有攸往。",
        "zh_hans": "不耕获；不菑畬；则利有攸往。"
      },
      "xiao_xiang": {
        "zh_hant": "不耕穫、未富也。",
        "zh_hans": "不耕获、未富也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "六三",
        "zh_hans": "六三"
      },
      "text": {
        "zh_hant": "无妄之災，或繫之牛，行人之得，邑人之災。",
        "zh_hans": "无妄之灾，或系之牛，行人之得，邑人之灾。"
      },
      "xiao_xiang": {
        "zh_hant": "行人得牛、邑人災也。",
        "zh_hans": "行人得牛、邑人灾也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "九四",
        "zh_hans": "九四"
      },
      "text": {
        "zh_hant": "可貞，无咎。",
        "zh_hans": "可贞，无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "可貞无咎、固有之也。",
        "zh_hans": "可贞无咎、固有之也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "九五",
        "zh_hans": "九五"
      },
      "text": {
        "zh_hant": "无妄之疾，勿藥有喜。",
        "zh_hans": "无妄之疾，勿药有喜。"
      },
      "xiao_xiang": {
        "zh_hant": "无妄之藥、不可試也。",
        "zh_hans": "无妄之药、不可试也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上九",
        "zh_hans": "上九"
      },
      "text": {
        "zh_hant": "无妄，行有眚，无攸利。",
        "zh_hans": "无妄，行有眚，无攸利。"
      },
      "xiao_xiang": {
        "zh_hant": "无妄之行、窮之災也。",
        "zh_hans": "无妄之行、穷之灾也。"
      }
    }
  ],
