{
  "number": 48,
  "unicode": "䷯",
  "binary": "011010",
  "trigrams": {
    "lower": "xun",
    "upper": "kan"
  },
  "name": {
    "zh_hant": "井",
    "zh_hans": "井",
    "pinyin": "jǐng",
    "en": "The Well"
  },
  "judgment": {
    "zh_hant": "改邑不改井，无喪无得。往來井井。汔至，亦未繘井，羸其瓶，凶。",
    "zh_hans": "改邑不改井，无丧无得。往来井井。汔至，亦未繘井，羸其瓶，凶。"
  },
  "tuan": {
    "zh_hant": "巽乎水而上水，井。井養而不窮也。改邑不改井、乃以剛中也。汔至、亦未繘井、未有功也，羸其瓶、是以凶也。",
    "zh_hans": "巽乎水而上水，井。井养而不穷也。改邑不改井、乃以刚中也。汔至、亦未繘井、未有功也，羸其瓶、是以凶也。"
  },
  "image": {
    "zh_hant": "木上有水，井。君子以勞民勸相。",
    "zh_hans": "木上有水，井。君子以劳民劝相。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初六",
        "zh_hans": "初六"
      },
      "text": {
        "zh_hant": "井泥不食。舊井无禽。",
        "zh_hans": "井泥不食。旧井无禽。"
      },
      "xiao_xiang": {
        "zh_hant": "井泥不食、下也，舊井无禽、時舍也。",
        "zh_hans": "井泥不食、下也，旧井无禽、时舍也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "九二",
        "zh_hans": "九二"
      },
      "text": {
        "zh_hant": "井谷射鮒，甕敝漏。",
        "zh_hans": "井谷射鲋，瓮敝漏。"
      },
      "xiao_xiang": {
        "zh_hant": "井谷射鮒、无與也。",
        "zh_hans": "井谷射鲋、无与也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "九三",
        "zh_hans": "九三"
      },
      "text": {
        "zh_hant": "井渫不食，為我心惻。可用汲，王明，並受其福。",
        "zh_hans": "井渫不食，为我心恻。可用汲，王明，并受其福。"
      },
      "xiao_xiang": {
        "zh_hant": "井渫不食、行惻也，求王明、受福也。",
        "zh_hans": "井渫不食、行恻也，求王明、受福也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "六四",
        "zh_hans": "六四"
      },
      "text": {
        "zh_hant": "井甃，无咎。",
        "zh_hans": "井甃，无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "井甃无咎、脩井也。",
        "zh_hans": "井甃无咎、修井也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "九五",
        "zh_hans": "九五"
      },
      "text": {
        "zh_hant": "井冽寒泉，食。",
        "zh_hans": "井冽寒泉，食。"
      },
      "xiao_xiang": {
        "zh_hant": "寒泉之食、中正也。",
        "zh_hans": "寒泉之食、中正也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上六",
        "zh_hans": "上六"
      },
      "text": {
        "zh_hant": "井收勿幕，有孚元吉。",
        "zh_hans": "井收勿幕，有孚元吉。"
      },
      "xiao_xiang": {
        "zh_hant": "元吉在上、大成也。",
        "zh_hans": "元吉在上、大成也。"
      }
    }
  ],
