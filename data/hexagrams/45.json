{
  "number": 45,
  "unicode": "䷬",
  "binary": "000110",
  "trigrams": {
    "lower": "kun",
    "upper": "dui"
  },
  "name": {
    "zh_hant": "萃",
    "zh_hans": "萃",
    "pinyin": "cuì",
    "en": "Gathering"
  },
  "judgment": {
    "zh_hant": "亨，王假有廟。利見大人。亨，利貞，用大牲吉。利有攸往。",
    "zh_hans": "亨，王假有庙。利见大人。亨，利贞，用大牲吉。利有攸往。"
  },
  "tuan": {
    "zh_hant": "萃、聚也。順以說，剛中而應，故聚也。王假有廟、致孝享也，利見大人亨、聚以正也，用大牲吉、利有攸往、順天命也。觀其所聚而天地萬物之情可見矣。",
    "zh_hans": "萃、聚也。顺以说，刚中而应，故聚也。王假有庙、致孝享也，利见大人亨、聚以正也，用大牲吉、利有攸往、顺天命也。观其所聚而天地万物之情可见矣。"
  },
  "image": {
    "zh_hant": "澤上於地，萃。君子以除戎器，戒不虞。",
    "zh_hans": "泽上于地，萃。君子以除戎器，戒不虞。"
  },
  "lines": [
    {
      "position": 1,
      "label": {
        "zh_hant": "初六",
        "zh_hans": "初六"
      },
      "text": {
        "zh_hant": "有孚不終，乃亂乃萃，若號一握為笑，勿恤，往无咎。",
        "zh_hans": "有孚不终，乃乱乃萃，若号一握为笑，勿恤，往无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "乃亂乃萃、其志亂也。",
        "zh_hans": "乃乱乃萃、其志乱也。"
      }
    },
    {
      "position": 2,
      "label": {
        "zh_hant": "六二",
        "zh_hans": "六二"
      },
      "text": {
        "zh_hant": "引吉，无咎，孚乃利用禴。",
        "zh_hans": "引吉，无咎，孚乃利用禴。"
      },
      "xiao_xiang": {
        "zh_hant": "引吉无咎、中未變也。",
        "zh_hans": "引吉无咎、中未变也。"
      }
    },
    {
      "position": 3,
      "label": {
        "zh_hant": "六三",
        "zh_hans": "六三"
      },
      "text": {
        "zh_hant": "萃如嗟如，无攸利，往无咎，小吝。",
        "zh_hans": "萃如嗟如，无攸利，往无咎，小吝。"
      },
      "xiao_xiang": {
        "zh_hant": "往无咎、上巽也。",
        "zh_hans": "往无咎、上巽也。"
      }
    },
    {
      "position": 4,
      "label": {
        "zh_hant": "九四",
        "zh_hans": "九四"
      },
      "text": {
        "zh_hant": "大吉无咎。",
        "zh_hans": "大吉无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "大吉无咎、位不當也。",
        "zh_hans": "大吉无咎、位不当也。"
      }
    },
    {
      "position": 5,
      "label": {
        "zh_hant": "九五",
        "zh_hans": "九五"
      },
      "text": {
        "zh_hant": "萃有位，无咎。匪孚，元、永貞悔亡。",
        "zh_hans": "萃有位，无咎。匪孚，元、永贞悔亡。"
      },
      "xiao_xiang": {
        "zh_hant": "萃有位、志未光也。",
        "zh_hans": "萃有位、志未光也。"
      }
    },
    {
      "position": 6,
      "label": {
        "zh_hant": "上六",
        "zh_hans": "上六"
      },
      "text": {
        "zh_hant": "齎咨涕洟，无咎。",
        "zh_hans": "赍咨涕洟，无咎。"
      },
      "xiao_xiang": {
        "zh_hant": "齎咨涕洟、未安上也。",
        "zh_hans": "赍咨涕洟、未安上也。"
      }
    }
  ],
